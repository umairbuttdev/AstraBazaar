# Pooled connection for the Nest API at runtime (port 6543)
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:[YOUR-PASSWORD]@aws-0-YOUR-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct/session connection for Prisma migrations (port 5432)
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:[YOUR-PASSWORD]@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres"

# Supabase Auth (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Web -> API
API_URL="http://127.0.0.1:3001"
NEXT_PUBLIC_API_URL="http://127.0.0.1:3001"

# Public site origin used for canonical URLs, sitemap, and Open Graph
NEXT_PUBLIC_SITE_URL="http://127.0.0.1:3000"

# Comma-separated browser origins allowed to call the API.
# Required when NODE_ENV=production. Local dev also allows localhost:3000.
WEB_ORIGINS="http://127.0.0.1:3000,http://localhost:3000"

# Set to 1 when the API runs behind a trusted reverse proxy.
TRUST_PROXY="0"

# Optional analytics collector. Events stay in the browser until this is set.
# Do not point this at a logger that stores addresses, tokens, or payment data.
NEXT_PUBLIC_ANALYTICS_ENDPOINT=""

# Comma-separated emails that should receive ADMIN role on login
ADMIN_EMAILS="you@example.com"
