# Pooled connection for the Nest API at runtime (port 6543)
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:[YOUR-PASSWORD]@aws-0-YOUR-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct/session connection for Prisma migrations (port 5432)
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:[YOUR-PASSWORD]@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres"

# Supabase Auth (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Web -> API
API_URL="http://127.0.0.1:3001"
NEXT_PUBLIC_API_URL="http://127.0.0.1:3001"
